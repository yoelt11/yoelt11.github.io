---
import Layout from "../layouts/Layout.astro";
import NewsPanel from "../components/NewsPanel.astro";
const news = [
  { date: "Oct 2026", text: "Launched this personal website — built with Astro, hosted on GitHub Pages.", href: "/projects/", hrefLabel: "Projects" },
  { date: "Oct 2023", text: "Completed my master's thesis on an artificial neural network framework for reduced order modeling.", href: "/publications/", hrefLabel: "Publications" },
  { date: "2023",     text: "Worked on activity recognition via object detection and sequences of poses at Anasoft Technology AG.", href: "/projects/activity-recognition/", hrefLabel: "Project" },
];
---
<Layout title="Edgar Torres" active="home">
  <section class="hero">
    <div class="hero-card">
      <img class="portrait" src="/profile-picture.png" alt="Edgar Torres" />
      <div class="hero-text">
        <h1>Hi, I'm Edgar Torres</h1>
        <p class="sub">Machine Learning Researcher &amp; Musician</p>
        <p class="value">I develop machine-learning methods for solving PDEs more efficiently, with a focus on
           physics-informed neural networks, radial-basis-function methods, and domain decomposition. My work
           connects numerical methods and ML to make amortized PDE solvers more accurate, scalable, and reusable.</p>
        <div class="ctas">
          <a class="btn primary" href="mailto:edgar.torres@ki.uni-stuttgart.de">Email me</a>
          <a class="btn" href="/publications/">Publications</a>
          <a class="btn" href="/projects/">Projects</a>
        </div>
      </div>
    </div>
  </section>

  <section class="home-sections">
    <div class="focus">
      <h2>Current focus</h2>
      <p>Amortized PDE solving with PINNs, RBF methods, and domain decomposition.</p>
    </div>
    <NewsPanel items={news} />
  </section>
</Layout>
<style is:inline>
  .hero { padding:4rem 0 1.5rem; }
  .hero-card { display:flex; gap:2rem; align-items:center; flex-wrap:wrap; }
  .portrait { width:170px; height:170px; border-radius:50%; object-fit:cover;
              border:3px solid #60a5fa; box-shadow:0 0 0 6px rgba(96,165,250,.12),
              0 10px 40px rgba(96,165,250,.22); }
  .hero-text { flex:1; min-width:280px; }
  .hero h1 { font-size:2.6rem; margin:0 0 .4rem; }
  .sub { color:#2dd4bf; font-weight:600; margin:0 0 1rem; }
  .value { color:#cbd5e1; max-width:64ch; margin:0 0 1.25rem; }
  .ctas { display:flex; gap:.7rem; flex-wrap:wrap; }
  .btn { display:inline-block; padding:.55rem 1.1rem; border-radius:8px;
         border:1px solid #334155; color:#e5e7eb; text-decoration:none; font-weight:600; font-size:.92rem;
         transition:border-color .15s, background .15s; }
  .btn:hover { border-color:#2dd4bf; color:#2dd4bf; }
  .btn.primary { background:#2563eb; border-color:#2563eb; color:#fff; }
  .btn.primary:hover { background:#1d4ed8; border-color:#1d4ed8; color:#fff; }
  .home-sections { border-top:1px solid #334155; margin-top:2.5rem; padding-top:1.75rem;
                   display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:1.5rem;
                   align-items:start; }
  .focus h2 { font-size:1rem; text-transform:uppercase; letter-spacing:.08em;
              color:#60a5fa; margin:0 0 .5rem; }
  .focus p { margin:0; color:#9ca3af; line-height:1.6; }
</style>
