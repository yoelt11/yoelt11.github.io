---
interface Props { title: string; lead: string }
const { title, lead } = Astro.props;
---
<section class="banner">
  <h2>{title}</h2>
  <p>{lead}</p>
</section>
<style>
  .banner { border:1px solid #30363d; border-radius:14px; padding:1.4rem 1.6rem;
            margin:1.6rem 0 1.8rem;
            background:linear-gradient(120deg, rgba(168,85,247,.10), rgba(251,191,36,.04) 60%); }
  .banner h2 { margin:0 0 .35rem; font-size:1.6rem; color:#a855f7; }
  .banner p { margin:0; color:#a99fc4; max-width:70ch; }
</style>
