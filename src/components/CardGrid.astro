---
import Card from "./Card.astro";
interface Props {
  items: Array<{ href:string; title:string; teaser:string; meta?:string; tags?:string[] }>;
  cols?: 2|3;
}
const { items, cols = 2 } = Astro.props;
---
{items.length===0 ? <p style="color:#8b949e">Nothing here yet.</p> : (
<ul class:list={["grid", cols===3 && "c3"]}>
  {items.map((it)=><li><Card {...it}/></li>)}
</ul>
)}
<style>
  .grid { list-style:none; margin:0; padding:0; display:grid; gap:1rem;
          grid-template-columns:repeat(2,1fr); }
  .grid.c3 { grid-template-columns:repeat(3,1fr); }
  li { min-width:0; }
  @media (max-width:680px){ .grid,.grid.c3 { grid-template-columns:1fr; } }
</style>
