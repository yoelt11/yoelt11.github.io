---
interface NewsItem { date: string; text: string; href?: string; hrefLabel?: string }
interface Props { title?: string; items: NewsItem[] }
const { title = "News", items } = Astro.props;
---
<section class="news-panel">
  <div class="news-head">
    <span class="news-dot"></span>
    <h2>{title}</h2>
  </div>
  <div class="news-rule"></div>
  {items.length === 0
    ? <p class="empty">Nothing to announce yet.</p>
    : (
    <ul class="news-list">
      {items.map((it) => (
        <li class="news-item">
          <span class="news-date">{it.date}</span>
          <span class="news-text">
            {it.text}
            {it.href && <a href={it.href}>{it.hrefLabel ?? it.href}</a>}
          </span>
        </li>
      ))}
    </ul>
    )}
</section>
<style>
  .news-panel { border:1px solid #334155; border-radius:14px; padding:1.25rem 1.5rem 1.1rem;
                background:linear-gradient(135deg, rgba(37,99,235,.06), rgba(45,212,191,.03) 60%), #111827;
                box-shadow:0 8px 30px rgba(2,6,23,.35); }
  .news-head { display:flex; align-items:center; gap:.6rem; margin-bottom:.3rem; }
  .news-head h2 { margin:0; font-size:1.05rem; font-weight:800; letter-spacing:.14em;
                  text-transform:uppercase; color:#60a5fa; }
  .news-dot { width:9px; height:9px; border-radius:50%; background:#2dd4bf; flex-shrink:0;
              box-shadow:0 0 0 0 rgba(45,212,191,.5); animation: news-pulse 2.2s ease-out infinite; }
  @keyframes news-pulse {
    0%   { box-shadow:0 0 0 0 rgba(45,212,191,.45); }
    70%  { box-shadow:0 0 0 11px rgba(45,212,191,0); }
    100% { box-shadow:0 0 0 0 rgba(45,212,191,0); }
  }
  .news-rule { height:2px; width:54px; border-radius:2px; margin:0 0 .9rem;
               background:linear-gradient(90deg, #2563eb, rgba(45,212,191,.15)); }
  .news-list { list-style:none; margin:0; padding:0; height:72px; overflow-y:scroll; overflow-x:hidden; scrollbar-width:thin; scrollbar-color:#60a5fa #1f2937; }
  .news-list::-webkit-scrollbar { width:8px; }
  .news-list::-webkit-scrollbar-track { background:#1f2937; border-radius:999px; }
  .news-list::-webkit-scrollbar-thumb { background:#60a5fa; border-radius:999px; }
  .news-item { padding:.55rem .7rem .55rem .85rem; border-radius:8px;
               border-left:2px solid rgba(37,99,235,.35); transition:background .2s, border-color .2s; }
  .news-item + .news-item { margin-top:.35rem; }
  .news-item:hover { background:rgba(37,99,235,.07); border-left-color:#60a5fa; }
  .news-date { display:block; font-size:.72rem; color:#9ca3af; letter-spacing:.04em; }
  .news-text { display:block; margin-top:.1rem; font-size:.95rem; color:#cbd5e1; line-height:1.55; }
  .news-text a { color:#60a5fa; }
  .empty { color:#9ca3af; font-size:.9rem; margin:.4rem 0 0; }
</style>
