---
interface Entry { org: string; date: string; role: string; desc: string; logo?: string; logoSite?: string; tag?: string; site?: string; siteLabel?: string; }
interface Props { title: string; entries: Entry[]; highlights?: Entry[]; subtitle?: string }
const { title, entries, highlights = [], subtitle } = Astro.props;
---
<section class="timeline-section">
  <h2>{title}</h2>
  {subtitle && <p class="tl-subtitle">{subtitle}</p>}
  {highlights.length > 0 ? (
    <div class="highlights">
      {highlights.map((e) => (
        <div class="hl-card">
          <div class="hl-top">
            <span class="hl-role">{e.role}</span>
            <span class="hl-date">{e.date}</span>
          </div>
          {e.tag && <span class="tag-badge">{e.tag}</span>}
          <div class="hl-desc">{e.desc}</div>
          {e.site && <a class="hl-link" href={e.site} rel="noopener" target="_blank">{e.siteLabel ?? e.site}</a>}
        </div>
      ))}
    </div>
  ) : (
  <div class="tl">
    {entries.map((e) => (
      <div class="tl-item">
        <div class="tl-card">
          <div class="tl-body">
            <div class="tl-head">
              {e.org && <h5 class="tl-org">{e.org}</h5>}
              <span class="tl-date">{e.date}</span>
            </div>
            <div class="tl-role">{e.role}</div>
            {e.tag && <span class="tl-tag">{e.tag}</span>}
            <div class="tl-desc">{e.desc}</div>
            {e.site && <a class="tl-site" href={e.site} rel="noopener" target="_blank">{e.siteLabel ?? e.site}</a>}
          </div>
          {e.logo && (
            <div class="tl-logo">
              {e.logoSite ? <a href={e.logoSite} rel="noopener" target="_blank"><img src={e.logo} alt={e.org} loading="lazy" /></a>
                          : <img src={e.logo} alt={e.org} loading="lazy" />}
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
  )}
</section>
<style>
  .timeline-section { border-top:1px solid #334155; padding-top:1.75rem; margin-top:1rem; }
  .timeline-section h2 { font-size:1rem; text-transform:uppercase; letter-spacing:.08em;
                         color:#60a5fa; margin:0 0 .2rem; }
  .tl-subtitle { margin:0 0 1.1rem; font-size:.82rem; color:#9ca3af; }
  /* Highlights: real cards */
  .timeline-section.highlights-grid, .highlights {
    display:grid; grid-template-columns:repeat(auto-fit, minmax(300px, 1fr)); gap:1rem;
  }
  .hl-card {
    background:#111827; border:1px solid #334155; border-radius:12px;
    padding:1rem 1.15rem; display:flex; flex-direction:column; gap:.45rem;
    box-shadow:0 1px 3px rgba(0,0,0,.4);
    transition:border-color .15s, transform .15s;
  }
  .hl-card:hover { border-color:#60a5fa; transform:translateY(-2px); }
  .hl-top { display:flex; align-items:baseline; justify-content:space-between; gap:.6rem; flex-wrap:wrap; }
  .hl-role { font-weight:700; font-size:.95rem; color:#e5e7eb; line-height:1.35; }
  .hl-date { font-size:.74rem; color:#2dd4bf; background:rgba(45,212,191,.08);
             border:1px solid rgba(45,212,191,.25); border-radius:999px; padding:2px 10px; white-space:nowrap; }
  .tag-badge {
    align-self:flex-start; font-size:.64rem; font-weight:800; text-transform:uppercase; letter-spacing:.08em;
    color:#fbbf24; background:rgba(251,191,36,.10); border:1px solid rgba(251,191,36,.45);
    border-radius:999px; padding:.12rem .6rem;
  }
  .hl-desc { color:#9ca3af; font-size:.87rem; line-height:1.55; }
  .hl-link { font-size:.84rem; color:#60a5fa; font-weight:600; }
  .tl { position:relative; max-width:820px; margin:0; padding-left:36px; }
  .tl::before { content:""; position:absolute; left:7px; top:12px; bottom:12px; width:2px;
                background:linear-gradient(to bottom, rgba(96,165,250,.75), rgba(45,212,191,.12));
                border-radius:2px; }
  .tl::after { content:"Now →"; position:absolute; left:-4px; top:-2px; font-size:.66rem;
               font-weight:800; letter-spacing:.08em; color:#2dd4bf;
               background:#0b1020; padding:0 4px 0 0; transform:translateX(-100%);
               white-space:nowrap; }
  .tl-item { position:relative; }
  .tl-item + .tl-item { margin-top:.9rem; }
  .tl-item::before { content:""; position:absolute; left:-35px; top:20px; width:14px; height:14px;
                     border-radius:50%; background:#0b1020; border:3px solid #60a5fa;
                     box-shadow:0 0 0 4px rgba(96,165,250,.12); z-index:2;
                     transition:transform .2s ease; }
  .tl-item:hover::before { transform:scale(1.2); }
  .tl-card { border:1px solid #334155; border-radius:12px; padding:1rem 1.2rem;
             background:#111827; display:flex; align-items:center; gap:1.25rem;
             transition:border-color .15s, transform .15s; }
  .tl-card:hover { border-color:#60a5fa; transform:translateX(5px); }
  .tl-body { flex:1; min-width:0; }
  .tl-head { display:flex; align-items:baseline; justify-content:space-between; gap:1rem; flex-wrap:wrap; }
  .tl-org { margin:0; font-size:1.05rem; color:#e5e7eb; font-weight:700; }
  .tl-date { font-size:.75rem; color:#2dd4bf; background:rgba(45,212,191,.08);
             border:1px solid rgba(45,212,191,.25); border-radius:999px; padding:2px 10px; white-space:nowrap; }
  .tl-role { margin:.25rem 0 .35rem; font-size:.9rem; color:#60a5fa; font-weight:600; }
  .tl-tag { display:inline-block; margin:0 0 .35rem; font-size:.62rem; font-weight:800;
            text-transform:uppercase; letter-spacing:.08em; color:#fbbf24;
            background:rgba(251,191,36,.10); border:1px solid rgba(251,191,36,.45);
            border-radius:999px; padding:.12rem .6rem; }
  .tl-site { display:inline-block; margin-top:.3rem; font-size:.84rem; color:#60a5fa; font-weight:600; }
  .tl-desc { margin:0; font-size:.9rem; color:#9ca3af; line-height:1.55; }
  .tl-logo { flex-shrink:0; width:86px; display:flex; align-items:center; justify-content:center; }
  .tl-logo img { max-width:86px; max-height:44px; width:auto; height:auto; object-fit:contain; }
</style>
